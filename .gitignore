# Ignore Maven build output
**/target/

# Ignore packaged artifacts
**/*.jar
**/*.war
**/*.ear

# IDE files
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Eclipse
.classpath
.project
.settings/

# IntelliJ
out/

# Maven wrapper binaries (do not ignore properties if you want wrapper to work)
.mvn/wrapper/maven-wrapper.jar
# keep maven-wrapper.properties tracked so wrapper can download
# .mvn/wrapper/maven-wrapper.properties

# Others
*.tmp
*.swp

# Local secrets (copy .env.example to .env and fill in real values)
.env

# Node (if any)
node_modules/

# Exclude generated folders
**/target/

# Do not accidentally ignore sources or configs
!**/src/**
!**/pom.xml
!**/application*.yml
!**/application*.properties

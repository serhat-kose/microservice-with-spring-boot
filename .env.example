# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored - never commit real secrets.

# HMAC signing key shared by auth-service (issues JWTs) and api-gateway (validates
# them). Must be a long, random value in any non-local environment.
JWT_SECRET=change_this_to_a_long_random_value

# Postgres password used by every postgres-* container and every service's
# SPRING_DATASOURCE_PASSWORD.
POSTGRES_PASSWORD=postgres

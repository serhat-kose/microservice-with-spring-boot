{
  "index": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "max_result_window": 10000
  },
  "analysis": {
    "filter": {
      "turkish_stop": {
        "type": "stop",
        "stopwords": "_turkish_"
      },
      "edge_ngram_filter": {
        "type": "edge_ngram",
        "min_gram": 2,
        "max_gram": 20
      }
    },
    "analyzer": {
      "catalog_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding",
          "turkish_stop"
        ]
      },
      "catalog_autocomplete": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding",
          "edge_ngram_filter"
        ]
      }
    }
  }
}
